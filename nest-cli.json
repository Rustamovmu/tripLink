{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/trip-link/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/trip-link/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/trip-link",
  "projects": {
    "batch": {
      "type": "application",
      "root": "apps/batch",
      "entryFile": "main",
      "sourceRoot": "apps/batch/src",
      "compilerOptions": {
        "tsConfigPath": "apps/batch/tsconfig.app.json"
      }
    },
    "trip-link": {
      "type": "application",
      "root": "apps/trip-link",
      "entryFile": "main",
      "sourceRoot": "apps/trip-link/src",
      "compilerOptions": {
        "tsConfigPath": "apps/trip-link/tsconfig.app.json"
      }
    }
  }
}