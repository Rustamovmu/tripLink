# Local direct development (npm run start:dev). Keep credentials in ignored .env.
PORT_API=3007
PORT_BATCH=3008
# All non-test modes currently use MONGO_PROD; MONGO_DEV is used by NODE_ENV=test.
# Supply private replica-set MongoDB URIs; do not copy production records for tests.
MONGO_PROD=
MONGO_DEV=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Authentication: generate two distinct secrets with at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_SESSION_MAX_AGE=30d
FRONTEND_ORIGINS=http://localhost:3000
# Production always enables Secure. SameSite=None additionally requires HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# MongoDB must support transactions for existing TripLink business operations.
# Configure only for a known, fixed reverse-proxy topology. Zero trusts no proxy headers.
AUTH_TRUST_PROXY_HOPS=0

# Unified account providers: leave disabled until credentials and callbacks are registered.
AUTH_FRONTEND_URL=http://localhost:3000
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3007/auth/oauth/google/callback
TELEGRAM_ENABLED=false
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_CALLBACK_URL=http://localhost:3007/auth/oauth/telegram/callback
KAKAO_ENABLED=false
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:3007/auth/oauth/kakao/callback

# Optional recovery email delivery; TLS required on port 587 or implicit TLS on 465.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Production Compose is HTTPS-only and exposes API port 4001 on loopback for a host proxy.
# Replace the local values above with your chosen, real public origin, for example:
# FRONTEND_ORIGINS=https://triplink.example
# AUTH_FRONTEND_URL=https://triplink.example
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAME_SITE=lax
# AUTH_TRUST_PROXY_HOPS=1  (only with the single host proxy in deploy/nginx.triplink.conf.example)
# Enabled providers also need their exact public HTTPS /auth/oauth/<provider>/callback URL.
# Keep JWT secrets stable across restarts/replicas. Never generate them in a startup command.
# See docs/deployment-auth.md. Do not use this example hostname as a live deployment value.
